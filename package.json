{
  "name": "ada-auditor",
  "version": "1.0.0",
  "description": "Evidence-first ADA/WCAG accessibility auditor",
  "main": "dist/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:kernel": "tsc --project tsconfig.kernel.json",
    "build:documents": "tsx scripts/build-documents.ts",
    "vercel-build": "tsx scripts/prepare-jvm.ts && tsx scripts/prepare-verapdf.ts && tsx scripts/prepare-libreoffice.ts && next build",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "chaos": "tsx scripts/chaos.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "next typegen && tsc -p tsconfig.typecheck.json",
    "playwright:install": "playwright install chromium",
    "prune:artifacts": "tsx scripts/prune-artifacts.ts",
    "migrate": "tsx scripts/migrate.ts",
    "operator": "tsx scripts/operator.ts",
    "smoke:real": "tsx scripts/smoke-real.ts",
    "blind:test": "tsx scripts/blind-test/run.ts",
    "blind:documents": "tsx scripts/doc-blind-test/run.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:hydration": "vitest run --config vitest.hydration.config.ts",
    "test:documents": "vitest run --config vitest.documents.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@neondatabase/serverless": "^1.1.0",
    "@pa11y/html_codesniffer": "^2.6.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.3",
    "@sparticuz/chromium": "^147.0.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.7.0",
    "@vercel/functions": "^3.8.0",
    "ai": "^6.0.266",
    "next": "^16.3.3",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opendataloader/pdf": "^2.5.0",
    "@types/node": "^26.1.2",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.3",
    "picomatch": "^4.0.5",
    "playwright": "^1.62.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
