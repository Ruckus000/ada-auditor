{
  "name": "ada-auditor",
  "version": "1.0.0",
  "description": "Evidence-first ADA/WCAG accessibility auditor",
  "main": "dist/index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:kernel": "tsc --project tsconfig.kernel.json",
    "start": "next start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "chaos": "tsx scripts/chaos.ts",
    "lint": "next lint",
    "playwright:install": "playwright install chromium",
    "prune:artifacts": "tsx scripts/prune-artifacts.ts",
    "migrate": "tsx scripts/migrate.ts",
    "operator": "tsx scripts/operator.ts",
    "smoke:real": "tsx scripts/smoke-real.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:hydration": "vitest run --config vitest.hydration.config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@axe-core/playwright": "^4.12.1",
    "@neondatabase/serverless": "^1.1.0",
    "@sparticuz/chromium": "^147.0.0",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.7.0",
    "@vercel/functions": "^3.8.0",
    "next": "^16.2.12",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/picomatch": "^4.0.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "picomatch": "^4.0.5",
    "playwright": "^1.62.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
