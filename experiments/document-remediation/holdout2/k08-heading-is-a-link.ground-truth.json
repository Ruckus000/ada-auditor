    { "level": 2, "text": "Infection Control", "isLink": true },
    { "level": 2, "text": "Safeguarding Adults", "isLink": true },
    { "level": 2, "text": "Records Management", "isLink": true }
  ],
  "mustNotBeHeadings": ["Version 7 · reviewed March 2026", "Version 4 · reviewed January 2026", "Version 11 · reviewed August 2026"],
  "readingOrder": ["H1","intro","H2 Infection Control","meta","para with inline link","H2 Safeguarding Adults","meta","para","H2 Records Management","meta","para"],
